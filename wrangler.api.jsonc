{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "linktery-public-api",
  "main": "./cloudflare/api-worker.ts",
  "compatibility_date": "2026-07-29",
  "minify": true,
  "send_metrics": false,
  "workers_dev": false,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.01
  },
  "ratelimits": [
    {
      "name": "API_EDGE_RATE_LIMITER",
      "namespace_id": "4101",
      "simple": { "limit": 300, "period": 60 }
    }
  ],
  "routes": [
    {
      "pattern": "api.linktery.com",
      "custom_domain": true
    }
  ],
  "vars": {
    "DEPLOY_ENV": "production",
    "PUBLIC_API_HOSTNAME": "api.linktery.com",
    "UPSTREAM_API_ORIGIN": "https://greenroute-pb.fly.dev"
  },
  "env": {
    "staging": {
      "name": "linktery-public-api-staging",
      "workers_dev": true,
      "preview_urls": true,
      "routes": [],
      "ratelimits": [
        {
          "name": "API_EDGE_RATE_LIMITER",
          "namespace_id": "4102",
          "simple": { "limit": 300, "period": 60 }
        }
      ],
      "vars": {
        "DEPLOY_ENV": "staging",
        "PUBLIC_API_HOSTNAME": "linktery-public-api-staging.footballonewso01.workers.dev",
        "UPSTREAM_API_ORIGIN": "https://greenroute-pb-staging.fly.dev"
      }
    }
  }
}
