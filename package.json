{
  "name": "vite_react_shadcn_ts",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "npm@10.9.3",
  "engines": {
    "node": ">=22.19 <25"
  },
  "scripts": {
    "dev": "vite",
    "dev:staging": "vite --mode staging",
    "build:client": "vite build",
    "build:server": "vite build --ssr src/entry-server.tsx --outDir dist-server",
    "prerender": "node scripts/prerender.mjs",
    "build": "node scripts/build-release.mjs auto",
    "build:production": "node scripts/build-release.mjs production",
    "build:staging": "node scripts/build-release.mjs staging",
    "build:dev": "vite build --mode development",
    "lint": "eslint .",
    "typecheck": "tsc -b --pretty false",
    "preview": "vite preview",
    "release:assert-clean": "node scripts/assert-clean-release.mjs",
    "release:check:staging": "npm run lint && npm run typecheck && npm test && npm run build:staging && npm run cf:dry-run:staging && npm run cf:smoke:local",
    "release:check:production": "npm run release:assert-clean && npm run lint && npm run typecheck && npm test && npm run build:production && npm run cf:dry-run:production && npm run cf:dry-run:alias && npm run cf:smoke:local && npm run cf:smoke:local:alias",
    "deploy:staging": "npm run release:check:staging && npm run cf:deploy:staging",
    "deploy:prod": "npm run release:check:production && npm run cf:deploy:production && npm run cf:smoke:production",
    "rollback:vercel:staging": "npx vercel --yes",
    "rollback:vercel:prod": "npx vercel --prod --yes",
    "cf:dev": "wrangler dev --env staging --local --port 8787",
    "cf:dry-run:production": "wrangler deploy --env=\"\" --dry-run --outdir .wrangler/dry-run-production",
    "cf:dry-run:alias": "wrangler deploy --env alias --dry-run --outdir .wrangler/dry-run-alias",
    "cf:dry-run:staging": "wrangler deploy --env staging --dry-run --outdir .wrangler/dry-run-staging",
    "cf:smoke": "node scripts/smoke-cloudflare.mjs",
    "cf:smoke:alias": "node scripts/smoke-cloudflare-alias.mjs",
    "cf:smoke:production": "node scripts/smoke-cloudflare.mjs https://linktery.com production && node scripts/smoke-cloudflare-alias.mjs https://linktery.bio production && node scripts/smoke-cloudflare-alias.mjs https://hotme.online production && node scripts/smoke-cloudflare-alias.mjs https://hotmylinks.cc production",
    "cf:smoke:local": "node scripts/run-cloudflare-smoke.mjs",
    "cf:smoke:local:alias": "node scripts/run-cloudflare-smoke.mjs alias",
    "cf:deploy:staging": "wrangler deploy --env staging",
    "cf:deploy:production:primary": "wrangler deploy --env=\"\"",
    "cf:deploy:production:alias": "wrangler deploy --env alias",
    "cf:deploy:production": "npm run cf:deploy:production:primary && npm run cf:deploy:production:alias",
    "cf:upload:candidate": "node scripts/upload-cloudflare-candidate.mjs",
    "test": "vitest run",
    "test:watch": "vitest"
  },
